# JARVIS — dev local, deploy na Rock Pi
HARDWARE_MODE=mock
# Na Rock Pi use: HARDWARE_MODE=rockpi

# IA Local (Ollama + Qwen):
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Ajuste fino p/ Rock Pi: timeout (ms) e tamanho da resposta (menor = mais rápido)
OLLAMA_TIMEOUT_MS=45000
OLLAMA_NUM_PREDICT=40

# Banco de Dados (PostgreSQL):
DATABASE_URL=postgresql://datafaz:datafaz@localhost:5432/jarvis

# Tuya BLE (ponte Python): no PC, BLE_ENABLED=1 controla a lampada via WinRT
# sem mudar o resto do hardware (que continua em mock).
# BLE_ENABLED=1
# TUYA_BLE_PROJECT=C:\Users\seu.usuario\tuya-ble
# TUYA_BLE_PYTHON=C:\Users\seu.usuario\tuya-ble\.venv\Scripts\python.exe
# TUYA_BLE_TIMEOUT_MS=90000

# MQTT_URL=mqtt://localhost:1883
